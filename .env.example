DATABASE_URL_OWNER=postgres://postgres:postgres@localhost:5432/tutor
DATABASE_URL_APP=postgres://app_user:app_user@localhost:5432/tutor
DATABASE_URL_ADMIN=postgres://app_admin:app_admin@localhost:5432/tutor
APP_URL=http://localhost:3000
BLOB_DIR=.data/blobs
EMBEDDER=fake
# pg-boss (content ingestion queue) connects with DATABASE_URL_OWNER because it creates the `pgboss` schema.
# Run the worker with: pnpm worker

# Tutor agent
# Deterministic mock AI (no keys needed). 1 = force on, 0 = force off, unset = on only under NODE_ENV=development
# (`pnpm dev`, `pnpm worker:dev`) with no real-provider config. Plain `pnpm worker`/production never enables it unasked.
# WARNING: setting AI_MOCK=1, an LLM_*_MODEL of mock/... or DECIDER=mock is an explicit opt-in that applies even in
# production and serves fake answers. Never set them on a real deployment.
AI_MOCK=
# provider/model, provider in openai|anthropic|google|compat (compat uses OPENAI_COMPAT_BASE_URL)
# mock/standard and mock/advanced select the mock model (an explicit opt-in that applies even in production).
LLM_STANDARD_MODEL=
LLM_ADVANCED_MODEL=
OPENAI_COMPAT_BASE_URL=
# jev | llm | mock | none (default: jev if TYPESAFE_API_KEY, else llm if LLM_STANDARD_MODEL, else mock in mock mode, else none)
# DECIDER=mock is an explicit mock opt-in that applies even in production; DECIDER=none disables routing decisions.
DECIDER=
TYPESAFE_API_KEY=
# tokens (in + out) per student per UTC day
STUDENT_DAILY_TOKEN_LIMIT=200000
# JSON: {"openai/gpt-4o-mini":{"inPerM":0.15,"outPerM":0.6}}
MODEL_PRICES=
EVAL_JUDGE_MODEL=

# Number of trusted reverse proxies in front of the app; the client IP (rate limiting) is the Nth x-forwarded-for entry from the right. 0 = ignore the header.
# With a value above 0 and no x-forwarded-for on a request, every such client shares one 'unknown' rate-limit bucket and a warning is logged once per process.
TRUSTED_PROXY_HOPS=1
# Login throttling: failed attempts per normalized username (default 10) and per client IP (default 100; successes never count) per 15 min.
# RATE_LIMIT_LOGIN_USER=10
# RATE_LIMIT_LOGIN_IP=100
